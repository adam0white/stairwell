{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!.wrangler",
      "!test/fixtures/*.json",
      "!scratch",
      "!docs/playtests/*.json",
      "!.claude",
      "!pnpm-lock.yaml",
      "!historical/stairwell/test/fixtures/*.json",
      "!historical/stairwell/test/browser-reference"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
